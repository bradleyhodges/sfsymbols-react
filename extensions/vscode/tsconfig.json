{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "outDir": "dist"
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
